{
  "name": "bytematch",
  "version": "0.1.0",
  "private": true,
  "description": "Progress tracking for decompilation projects: objdiff reports, history, badges and PR comments.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 5000",
    "build": "next build && yarn build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "next start -H 0.0.0.0 -p 5000",
    "worker": "node --env-file-if-exists=.env dist/main.js",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test"
  },
  "dependencies": {
    "@octokit/webhooks-methods": "^6.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "geist": "^1.7.2",
    "next": "^16.4.2",
    "octokit": "^5.0.5",
    "opentype.js": "^2.0.0",
    "pg-boss": "^12.38.0",
    "pm2": "^7.0.4",
    "postgres": "^3.4.9",
    "protobufjs": "^8.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "yarn@4.18.1"
}
