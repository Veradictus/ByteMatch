# ByteMatch configuration. Copy to .env; it is read by `next start`, the worker and migrations.
# See docs/self-hosting.md for details.

# PostgreSQL connection string. The compose setup overrides this inside its containers.
DATABASE_URL=postgres://bytematch:bytematch@localhost:5432/bytematch

# Public address of this instance, without a trailing slash. Used in links, badges and PR comments.
# In production, e.g. PUBLIC_URL=https://bytematch.dev
PUBLIC_URL=http://localhost:5000

# Search engine verification (optional): the content="…" value from Google Search Console's or Bing
# Webmaster Tools' "HTML tag" method. Skip these if you verify the domain with a DNS record instead.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Shown in the page header and titles.
SITE_NAME=ByteMatch

# The community Discord linked in the header and footer. Leave empty to hide it.
SITE_DISCORD_URL=https://discord.gg/qqe7ZqCsMT

# --- GitHub -------------------------------------------------------------------------------------
# See docs/github-app.md.

# Optional fine-grained personal access token (public repository read is enough). Used to download
# artifacts from repositories where the GitHub App is not installed. GitHub requires authentication
# for artifact downloads even on public repositories.
GITHUB_TOKEN=

# GitHub App id and private key (PEM). The key may be on one line with literal \n sequences, in
# double quotes.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# The App's slug (github.com/apps/<slug>), for the "Install the App" link.
GITHUB_APP_SLUG=

# The webhook secret set on the App. Webhook URL: <PUBLIC_URL>/api/github/webhook
GITHUB_WEBHOOK_SECRET=

# The App's OAuth client, used for "Sign in with GitHub". Callback URL: <PUBLIC_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: a Twitch application's credentials, for IGDB game name lookups (docs/self-hosting.md#igdb).
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# --- Access -------------------------------------------------------------------------------------

# 32 random bytes as 64 hex characters or base64, e.g. `openssl rand -hex 32`. Encrypts signed-in
# users' GitHub tokens. Sign-in is disabled while this is empty.
SECRET_KEY=

# Comma-separated GitHub logins who can manage every project.
ADMIN_GITHUB_LOGINS=

# true: anyone signed in can add a repository they administer. false: site admins only.
OPEN_REGISTRATION=true

# --- Worker and storage -------------------------------------------------------------------------

# Minutes between checks for new CI runs.
POLL_INTERVAL_MINUTES=15

# 0 keeps every full report. Otherwise full reports older than this many days are dropped, except
# each version's latest. Measures and history are kept forever.
REPORT_RETENTION_DAYS=0

# Largest report accepted, in bytes (default 256 MiB).
MAX_REPORT_BYTES=268435456

# Source for "Import from decomp.dev".
DECOMP_DEV_URL=https://decomp.dev

# Jobs each worker process runs at once.
WORKER_CONCURRENCY=4
